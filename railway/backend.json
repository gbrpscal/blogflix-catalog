{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/php/Dockerfile",
    "watchPatterns": [
      "apps/backend/**",
      "docker/php/**",
      "railway/backend.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "php artisan migrate --force"
    ],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 70
  }
}
